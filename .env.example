# ==============================================================
# HEAVEN'S CAFE - VERCEL & ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Add these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Add

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon/Publishable Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# 3. Supabase Service Role Secret Key (Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. Optional: Public application URL (leave blank or set your *.vercel.app domain)
NEXT_PUBLIC_APP_URL=
